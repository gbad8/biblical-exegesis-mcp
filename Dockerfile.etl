# Multi-arch (linux/amd64 + linux/arm64) .NET 10 LTS ETL Runner
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

COPY BiblicalExegesisMcp.sln ./
COPY src/BiblicalExegesisMcp.Domain/BiblicalExegesisMcp.Domain.csproj src/BiblicalExegesisMcp.Domain/
COPY src/BiblicalExegesisMcp.Infrastructure/BiblicalExegesisMcp.Infrastructure.csproj src/BiblicalExegesisMcp.Infrastructure/
COPY src/BiblicalExegesisMcp.Etl/BiblicalExegesisMcp.Etl.csproj src/BiblicalExegesisMcp.Etl/
RUN dotnet restore src/BiblicalExegesisMcp.Etl/BiblicalExegesisMcp.Etl.csproj

COPY src/BiblicalExegesisMcp.Domain/ src/BiblicalExegesisMcp.Domain/
COPY src/BiblicalExegesisMcp.Infrastructure/ src/BiblicalExegesisMcp.Infrastructure/
COPY src/BiblicalExegesisMcp.Etl/ src/BiblicalExegesisMcp.Etl/
RUN dotnet publish src/BiblicalExegesisMcp.Etl/BiblicalExegesisMcp.Etl.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0-alpine AS runtime
WORKDIR /app

RUN apk add --no-cache icu-libs icu-data-full
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    ETL_DATA_DIR=/data/raw \
    ETL_SCHEMA_DIR=/app/schema

COPY --from=build /app/publish .
COPY db/init/ /app/schema/

ENTRYPOINT ["dotnet", "BiblicalExegesisMcp.Etl.dll"]
