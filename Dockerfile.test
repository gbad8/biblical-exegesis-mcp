# Containerized xUnit test runner (.NET 10 LTS)
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine
WORKDIR /src

RUN apk add --no-cache icu-libs icu-data-full
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

COPY BiblicalExegesisMcp.sln ./
COPY src/ src/
RUN dotnet restore BiblicalExegesisMcp.sln

ENTRYPOINT ["dotnet", "test", "BiblicalExegesisMcp.sln", "--no-restore", "--verbosity", "normal"]
