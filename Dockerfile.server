# Multi-arch (linux/amd64 + linux/arm64) .NET 10 LTS MCP Server
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

COPY GreekNtMcp.sln ./
COPY src/GreekNtMcp.Domain/GreekNtMcp.Domain.csproj src/GreekNtMcp.Domain/
COPY src/GreekNtMcp.Infrastructure/GreekNtMcp.Infrastructure.csproj src/GreekNtMcp.Infrastructure/
COPY src/GreekNtMcp.Server/GreekNtMcp.Server.csproj src/GreekNtMcp.Server/
RUN dotnet restore src/GreekNtMcp.Server/GreekNtMcp.Server.csproj

COPY src/GreekNtMcp.Domain/ src/GreekNtMcp.Domain/
COPY src/GreekNtMcp.Infrastructure/ src/GreekNtMcp.Infrastructure/
COPY src/GreekNtMcp.Server/ src/GreekNtMcp.Server/
RUN dotnet publish src/GreekNtMcp.Server/GreekNtMcp.Server.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

# Full ICU support is required for polytonic Greek Unicode normalization (FormD/FormC)
RUN apk add --no-cache icu-libs wget && adduser -D -H -u 10001 appuser
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production

COPY --from=build /app/publish .
USER appuser

EXPOSE 8080
ENTRYPOINT ["dotnet", "GreekNtMcp.Server.dll"]
