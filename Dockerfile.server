# Multi-arch (linux/amd64 + linux/arm64) .NET 10 LTS MCP Server
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

COPY BiblicalExegesisMcp.sln ./
COPY src/BiblicalExegesisMcp.Domain/BiblicalExegesisMcp.Domain.csproj src/BiblicalExegesisMcp.Domain/
COPY src/BiblicalExegesisMcp.Infrastructure/BiblicalExegesisMcp.Infrastructure.csproj src/BiblicalExegesisMcp.Infrastructure/
COPY src/BiblicalExegesisMcp.Server/BiblicalExegesisMcp.Server.csproj src/BiblicalExegesisMcp.Server/
RUN dotnet restore src/BiblicalExegesisMcp.Server/BiblicalExegesisMcp.Server.csproj

COPY src/BiblicalExegesisMcp.Domain/ src/BiblicalExegesisMcp.Domain/
COPY src/BiblicalExegesisMcp.Infrastructure/ src/BiblicalExegesisMcp.Infrastructure/
COPY src/BiblicalExegesisMcp.Server/ src/BiblicalExegesisMcp.Server/
RUN dotnet publish src/BiblicalExegesisMcp.Server/BiblicalExegesisMcp.Server.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

# Full ICU support is required for polytonic Greek and Hebrew Unicode normalization
RUN apk add --no-cache icu-libs icu-data-full wget && adduser -D -H -u 10001 appuser
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    ASPNETCORE_ENVIRONMENT=Production

COPY --from=build /app/publish .
USER appuser

EXPOSE 8080
ENTRYPOINT ["dotnet", "BiblicalExegesisMcp.Server.dll"]
