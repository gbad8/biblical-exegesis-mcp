# PostgreSQL credentials
POSTGRES_USER=exegesis
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=greek_nt

# Local development port (docker-compose.yml)
MCP_PORT=8080

# Production domain for Oracle Cloud Always Free (Caddy automatic HTTPS via Let's Encrypt)
# Example: exegesis.duckdns.org or mcp.yourdomain.com
MCP_DOMAIN=mcp.example.com

# Bearer Token for protecting /mcp endpoint (generate with: openssl rand -hex 32)
# Leave empty for local dev without auth; REQUIRED when using docker-compose.oci.yml
MCP_API_KEY=
